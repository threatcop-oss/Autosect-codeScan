<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Security Scan Report</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 2rem;
        background: #f7f8fa;
        color: #1b1f24;
      }
      h1 {
        margin-bottom: 0.25rem;
      }
      .summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
      }
      .summary-card {
        background: #ffffff;
        border-radius: 8px;
        padding: 1rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
      }
      table {
        width: 100%;
        border-collapse: collapse;
        background: #ffffff;
      }
      th,
      td {
        padding: 0.75rem;
        border-bottom: 1px solid #e5e7eb;
        text-align: left;
      }
      th {
        background: #f3f4f6;
      }
      .badge {
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.85rem;
        text-transform: uppercase;
      }
      .critical {
        background: #fee2e2;
        color: #991b1b;
      }
      .high {
        background: #ffedd5;
        color: #9a3412;
      }
      .medium {
        background: #fef3c7;
        color: #92400e;
      }
      .low {
        background: #e0f2fe;
        color: #0369a1;
      }
      .info {
        background: #e5e7eb;
        color: #374151;
      }
    </style>
  </head>
  <body>
    <h1>Security Scan Report</h1>
    <p>Generated at {{report.timestamp}}</p>
    <div class="summary">
      <div class="summary-card">
        <strong>Total Findings</strong>
        <p>{{summary.total}}</p>
      </div>
      {{#each summary.by_severity}}
        <div class="summary-card">
          <strong>{{@key}}</strong>
          <p>{{this}}</p>
        </div>
      {{/each}}
    </div>
    <h2>CVEs</h2>
    {{#if report.cves}}
      <ul>
        {{#each report.cves}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    {{else}}
      <p>None</p>
    {{/if}}
    <table>
      <thead>
        <tr>
          <th>Severity</th>
          <th>Tool</th>
          <th>Title</th>
          <th>CVE</th>
          <th>Installed Version</th>
          <th>Fixed Version</th>
          <th>File</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {{#each findings}}
          <tr>
            <td><span class="badge {{severity}}">{{severity}}</span></td>
            <td>{{tool}}</td>
            <td>{{title}}</td>
            <td>{{#if cve}}{{cve}}{{else}}-{{/if}}</td>
            <td>{{#if installedVersion}}{{installedVersion}}{{else}}-{{/if}}</td>
            <td>{{#if fixedVersion}}{{fixedVersion}}{{else}}-{{/if}}</td>
            <td>{{file}}{{#if line}}:{{line}}{{/if}}</td>
            <td>{{description}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </body>
</html>
